GAPPATCH_MASTER_EMAIL=master@gappatch.app
GAPPATCH_MASTER_INVITE_CODE=
GAPPATCH_TEST_EMAIL=test@gappatch.app
GAPPATCH_TEST_INVITE_CODE=

# Set to false only while serving the app over an IP-only HTTP endpoint.
# Remove this or set true after a HTTPS domain fronts the app.
GAPPATCH_SECURE_COOKIES=true

# Set to azure-openai only after the Azure deployment is ready.
GAPPATCH_GRADING_PROVIDER=deterministic
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_GRADING_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_GRADING_TIMEOUT_MS=8000

# Legacy aliases are also accepted for compatibility with older projects.
# LLM_API_ENDPOINT=https://your-resource.openai.azure.com
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_API_VERSION=2024-10-21
