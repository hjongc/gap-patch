{
  "name": "gappatch",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @gappatch/web dev",
    "build": "pnpm --filter @gappatch/web build",
    "lint": "biome check AGENTS.md README.md docs package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json biome.json vitest.config.ts playwright.config.ts apps/web/next.config.ts apps/web/src packages tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@gappatch/api-contracts": "workspace:*",
    "@gappatch/design-tokens": "workspace:*",
    "@gappatch/domain": "workspace:*",
    "@gappatch/product": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "ky": "^1.8.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
